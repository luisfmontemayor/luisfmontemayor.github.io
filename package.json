{
  "name": "luisfmontemayor.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && prettier --check \"*.html\"",
    "format": "biome check --write . && prettier --write \"*.html\"",
    "qa": "npm run format && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3"
  }
}
